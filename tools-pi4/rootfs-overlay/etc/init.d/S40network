#!/bin/sh
#
# Start the network....
#
# This overrides buildroot's default S40network (which runs `ifup -a`
# synchronously). On real Raspberry Pi 4 hardware running as a MiniVisorPi
# guest, there may be no Ethernet cable plugged in, so `udhcpc` retries
# DHCPDISCOVER forever and would otherwise block the rest of boot (and the
# login prompt) indefinitely. Run it in the background instead so boot always
# proceeds regardless of link state.
#

case "$1" in
  start)
	printf "Starting network: "
	/bin/hostname -F /etc/hostname
	if [ -e /etc/network/interfaces ]; then
		/sbin/ifup -a &
	fi
	echo "OK (backgrounded)"
	;;
  stop)
	printf "Stopping network: "
	if [ -e /etc/network/interfaces ]; then
		/sbin/ifdown -a
	fi
	echo "OK"
	;;
  restart)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
